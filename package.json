{
  "name": "simple-sleep-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --experimental-transform-types local/server.ts",
    "build": "vite build && node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:worker": "node tests/worker.mjs",
    "test:browser": "playwright test",
    "test:private": "node tests/private.mjs"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@playwright/test": "^1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "miniflare": "5.20261119.0-beta",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4"
  }
}
