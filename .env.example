# The synthetic preview needs no configuration.
# For the private profile, put values in a private environment file outside the checkout.
# SLEEP_PROFILE=<private-or-synthetic>
# SLEEP_PORT=<loopback-port>
# SLEEP_ORIGIN=<private-https-origin>
# SLEEP_OWNER_LOGIN=<verified-tailnet-login>
# SLEEP_DB=<absolute-path-outside-the-checkout>
# SLEEP_MCP_TOKEN=<optional-random-base64url-token>
